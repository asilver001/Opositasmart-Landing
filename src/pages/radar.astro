---
import BaseLayout from '../layouts/BaseLayout.astro';
import RadarPage from '../components/react/RadarPage.jsx';
---

<BaseLayout
  title="Radar de Oposiciones 2026 — Estado de convocatorias | Oposita Smart"
  description="7 convocatorias activas · 3.384 plazas. Auxiliar AGE, Administrativo AGE, Seguridad Social y más. Actualizado constantemente."
>
  <Fragment slot="head">
    <meta property="og:title" content="Radar de Oposiciones 2026 — Estado de convocatorias" />
    <meta property="og:description" content="7 convocatorias activas · 3.384 plazas. Auxiliar AGE, Administrativo AGE, Seguridad Social y más. Actualizado constantemente." />
    <meta property="og:url" content="https://opositasmart-landing.vercel.app/radar" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="canonical" href="https://opositasmart-landing.vercel.app/radar" />
  </Fragment>

  <main id="main-content">
    <RadarPage client:load />
  </main>
</BaseLayout>
