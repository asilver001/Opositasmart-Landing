---
import BaseLayout from '../layouts/BaseLayout.astro';
import RadarPage from '../components/react/RadarPage.jsx';
---

<BaseLayout
  title="Radar de Oposiciones 2026 — Estado de convocatorias | Oposita Smart"
  description="9 convocatorias activas · 9.695 plazas. Auxiliar AGE (1.700), Administrativo AGE (2.512), GACE, Hacienda y más. Actualizado abril 2026."
>
  <Fragment slot="head">
    <meta property="og:title" content="Radar de Oposiciones 2026 — 9.695 plazas convocadas" />
    <meta property="og:description" content="9 convocatorias activas · Auxiliar AGE (1.700), Administrativo AGE (2.512), GACE, Hacienda y más. Examen AGE: 23 mayo 2026." />
    <meta property="og:url" content="https://www.opositasmart.com/radar" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <link rel="canonical" href="https://www.opositasmart.com/radar" />
  </Fragment>

  <main id="main-content">
    <RadarPage client:load />
  </main>
</BaseLayout>
