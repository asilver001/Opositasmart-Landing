---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title="Oposita Smart | Prepara tu Oposición con Ciencia — App de Test Oposiciones 2026">
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Instrument+Sans:wght@400;600&display=swap" rel="stylesheet">
    <meta name="keywords" content="oposiciones auxiliar administrativo 2026, test oposiciones AGE, preparar oposiciones online, app oposiciones, oposiciones estado 2026, temario auxiliar administrativo">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Oposita Smart",
      "description": "App de preparación de oposiciones de Auxiliar Administrativo del Estado con ciencia cognitiva, repetición espaciada y preguntas calibradas al examen real.",
      "url": "https://www.opositasmart.com",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Web",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "EUR",
        "description": "Acceso fundador gratuito durante la beta"
      }
    })} />
  </Fragment>

  <!-- ========== HERO ========== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-content">
      <div>
        <div class="hero-eyebrow">Para quienes llevan demasiado tiempo esperando su plaza</div>
        <h1 id="hero-title">La academia<br>no te va a dar<br><em>esto gratis</em></h1>
        <p class="hero-sub">Diseñado para quienes no pueden dedicar 8 horas al día. 15 minutos de práctica inteligente valen más que 3 horas con apuntes viejos. Sin cuotas de academia, sin agobios.</p>
        <div class="hero-ctas">
          <div>
            <a href="https://app.opositasmart.com/#/welcome" class="btn-primary">Ver mi nivel ahora</a>
            <div class="cta-micro">Sin tarjeta · Sin contraseña · En 30 segundos</div>
          </div>
          <a href="#how" class="btn-secondary">Ver cómo funciona</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="floating-readiness">
          <div class="fr-label">Tu preparación</div>
          <div class="fr-value">73%</div>
          <div class="fr-bar"><div class="fr-bar-fill"></div></div>
        </div>
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-header"><span class="ph-title">Oposita Smart</span><span class="ph-badge">Tema 4</span></div>
            <div class="phone-question">
              <div class="pq-tema">Constitución Española</div>
              <div class="pq-text">¿Cuántos magistrados componen el Tribunal Constitucional?</div>
            </div>
            <div class="phone-options">
              <div class="phone-opt">A) 8 magistrados</div>
              <div class="phone-opt correct">B) 12 magistrados ✓</div>
              <div class="phone-opt">C) 15 magistrados</div>
              <div class="phone-opt">D) 10 magistrados</div>
            </div>
            <div class="phone-stats">
              <div class="phone-stat"><div class="ps-num">102</div><div class="ps-label">Preguntas</div></div>
              <div class="phone-stat"><div class="ps-num">78%</div><div class="ps-label">Precisión</div></div>
              <div class="phone-stat"><div class="ps-num">7</div><div class="ps-label">Días activos</div></div>
            </div>
          </div>
        </div>
        <div class="floating-streak">
          <span class="fs-fire">📅</span>
          <div><div class="fs-text">7 días activos esta semana</div><div class="fs-sub">Buen ritmo</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== INSIGHT BANNER ========== -->
  <div class="insight-banner">
    <div class="insight-text">El <strong>68% de los opositores que suspenden</strong> ya habían estudiado el temario completo al menos una vez. El problema no es el temario. <strong>Es el olvido.</strong></div>
    <div class="insight-source">Experiencia observada en comunidades de opositores AGE</div>
  </div>

  <!-- ========== SOCIAL STRIP ========== -->
  <div class="social-strip">
    <div class="social-strip-inner">
      <div class="ss-item"><span class="ss-num">5 min</span><span class="ss-text">al día son<br>suficientes</span></div>
      <div class="ss-divider"></div>
      <div class="ss-item"><span class="ss-num">1.414</span><span class="ss-text">preguntas del<br>temario oficial AGE</span></div>
      <div class="ss-divider"></div>
      <div class="ss-item"><span class="ss-num">14/28</span><span class="ss-text">temas disponibles<br>Bloque I completo</span></div>
      <div class="ss-divider"></div>
      <div class="ss-item"><span class="ss-num">0€</span><span class="ss-text">acceso fundador<br>durante la beta</span></div>
    </div>
  </div>

  <!-- ========== CONVOCATORIAS DASHBOARD ========== -->
  <section class="opo-dashboard" id="convocatorias" aria-labelledby="opo-title">
    <div class="opo-dashboard-header">
      <div class="eyebrow">Convocatorias 2025–2026</div>
      <h2 id="opo-title">Radar de Oposiciones en tiempo real</h2>
      <p>7 convocatorias activas · 3.384 plazas totales. Estado, plazas, fechas y enlaces al BOE. Actualizado constantemente.</p>
    </div>

    <div class="opo-stats-row">
      <div class="opo-stat-card">
        <div class="osc-num">3.384</div>
        <div class="osc-label">Plazas convocadas</div>
        <div class="osc-bar"><div class="osc-bar-fill" style="width:100%"></div></div>
      </div>
      <div class="opo-stat-card">
        <div class="osc-num">7</div>
        <div class="osc-label">Convocatorias activas</div>
        <div class="osc-bar"><div class="osc-bar-fill" style="width:40%"></div></div>
      </div>
      <div class="opo-stat-card">
        <div class="osc-num">83d</div>
        <div class="osc-label">Próximo examen AGE</div>
        <div class="osc-bar"><div class="osc-bar-fill" style="width:65%"></div></div>
      </div>
    </div>

    <div style="text-align: center; margin-top: 24px;">
      <a href="/radar" class="cta-radar-link">
        Ver todas las convocatorias →
      </a>
      <p style="font-size: 13px; color: var(--text-muted, #6B7280); margin-top: 8px;">
        Filtros por ámbito y nivel · Compartible en Facebook · Enlaces al BOE
      </p>
    </div>
  </section>

  <!-- ========== ACADEMY COMPARE ========== -->
  <section class="anti-academy" aria-labelledby="compare-title">
    <div class="anti-academy-header">
      <div class="eyebrow">Por qué funciona</div>
      <h2 id="compare-title">Sin academia. Sin horarios. Sin excusas.</h2>
    </div>
    <div class="compare-grid">
      <div class="compare-card old">
        <h3>Academia tradicional</h3>
        <div class="compare-row"><span class="icon">💸</span> 3.000–6.000€ al año</div>
        <div class="compare-row"><span class="icon">🕐</span> 3 horas diarias presenciales</div>
        <div class="compare-row"><span class="icon">📖</span> Temario estático, sin adaptación</div>
        <div class="compare-row"><span class="icon">❓</span> No sabes si estás listo hasta el examen</div>
        <div class="compare-row"><span class="icon">😰</span> Presión de grupo, ritmo impuesto</div>
      </div>
      <div class="compare-card new">
        <h3>Oposita Smart</h3>
        <div class="compare-row"><span class="icon">✅</span> Gratis (acceso fundador)</div>
        <div class="compare-row"><span class="icon">✅</span> 10–15 minutos al día</div>
        <div class="compare-row"><span class="icon">✅</span> Se adapta a lo que necesitas repasar</div>
        <div class="compare-row"><span class="icon">✅</span> Índice de preparación en tiempo real</div>
        <div class="compare-row"><span class="icon">✅</span> A tu ritmo, sin agobios</div>
      </div>
    </div>
  </section>

  <!-- ========== FEATURES GRID ========== -->
  <section class="features" id="features" aria-labelledby="features-title">
    <div class="features-header">
      <div class="eyebrow">Funcionalidades</div>
      <h2 id="features-title">Todo lo que necesitas para aprobar</h2>
    </div>
    <div class="features-grid">
      <article class="feature-card">
        <div class="fc-icon">🧠</div>
        <h3>El sistema que estudia por ti</h3>
        <p>El algoritmo FSRS calcula exactamente cuándo necesitas repasar cada pregunta. Estudias menos, retienes más.</p>
      </article>
      <article class="feature-card">
        <div class="fc-icon">📊</div>
        <h3>Sabes exactamente cuánto te falta</h3>
        <p>Un número del 0 al 100 que sube en tiempo real. Cuando pase de 75, estarás listo para presentarte.</p>
      </article>
      <article class="feature-card">
        <div class="fc-icon">⚡</div>
        <h3>5 minutos al día sin excusas</h3>
        <p>10 preguntas adaptadas a tu nivel. En el metro, en la pausa del café. Mantienes el ritmo sin reorganizar tu vida.</p>
      </article>
      <article class="feature-card">
        <div class="fc-icon">📝</div>
        <h3>El día del examen, sin sorpresas</h3>
        <p>100 preguntas, 60 minutos. Condiciones de examen real con análisis de tiempo por pregunta.</p>
      </article>
      <article class="feature-card">
        <div class="fc-icon">🗂</div>
        <h3>Lo que se te olvida, vuelve</h3>
        <p>Flashcards inteligentes que priorizan exactamente lo que te cuesta más. El olvido deja de ser un problema.</p>
      </article>
      <article class="feature-card">
        <div class="fc-icon">📈</div>
        <h3>Deja de estudiar lo que ya sabes</h3>
        <p>Ve qué temas tienes dominados y cuáles te van a costar el aprobado. Para de repasar la CE si tu punto débil es el TREBEP.</p>
      </article>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="how-section" id="how" aria-labelledby="how-title">
    <div class="how-inner">
      <div class="eyebrow how-eyebrow">El método</div>
      <h2 id="how-title">Cómo funciona</h2>
      <div class="how-steps">
        <div class="how-step">
          <div class="step-num">01</div>
          <h3>Elige tu oposición</h3>
          <p>Selecciona la oposición que preparas y configura tu ritmo de estudio ideal.</p>
        </div>
        <div class="how-step">
          <div class="step-num">02</div>
          <h3>Practica cada día</h3>
          <p>El algoritmo te dice qué repasar hoy. Solo unos minutos, sin agobios.</p>
        </div>
        <div class="how-step">
          <div class="step-num">03</div>
          <h3>Repasa con ciencia</h3>
          <p>La repetición espaciada te muestra las preguntas justo antes de que las olvides.</p>
        </div>
        <div class="how-step">
          <div class="step-num">04</div>
          <h3>Mide tu progreso</h3>
          <p>El índice de preparación sube mientras dominas más temas. Llegas con datos, no con esperanza.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== READINESS RADAR ========== -->
  <section class="radar-section" aria-labelledby="radar-title">
    <div class="radar-inner">
      <div>
        <div class="eyebrow">Tu panel de control</div>
        <h2 id="radar-title">¿Cuánto me falta?<br>Esa pregunta ya tiene respuesta</h2>
        <p class="radar-desc">El índice de preparación combina tres dimensiones para darte una foto real. Sin métricas vanidosas.</p>
        <div class="radar-dims">
          <div class="radar-dim">
            <div class="radar-dim-icon">📚</div>
            <div>
              <div class="radar-dim-title">Cobertura (30%)</div>
              <div class="radar-dim-sub">¿Cuántos temas has practicado?</div>
            </div>
          </div>
          <div class="radar-dim">
            <div class="radar-dim-icon">🎯</div>
            <div>
              <div class="radar-dim-title">Precisión (40%)</div>
              <div class="radar-dim-sub">¿Aciertas las preguntas?</div>
            </div>
          </div>
          <div class="radar-dim">
            <div class="radar-dim-icon">📝</div>
            <div>
              <div class="radar-dim-title">Simulacros (30%)</div>
              <div class="radar-dim-sub">¿Cómo rindes bajo presión?</div>
            </div>
          </div>
        </div>
      </div>
      <div class="dashboard-visual">
        <div class="radar-card">
          <div class="radar-card-label">Índice de preparación</div>
          <svg viewBox="0 0 300 280" class="radar-svg" aria-label="Gráfico radar de preparación">
            <g transform="translate(150,140)">
              <polygon points="0,-100 95,-31 59,81 -59,81 -95,-31" fill="none" stroke="#E8E4DE" stroke-width="1"/>
              <polygon points="0,-66 63,-20 39,54 -39,54 -63,-20" fill="none" stroke="#E8E4DE" stroke-width="1"/>
              <polygon points="0,-33 32,-10 20,27 -20,27 -32,-10" fill="none" stroke="#E8E4DE" stroke-width="1"/>
              <line x1="0" y1="0" x2="0" y2="-100" stroke="#E8E4DE" stroke-width="1"/>
              <line x1="0" y1="0" x2="95" y2="-31" stroke="#E8E4DE" stroke-width="1"/>
              <line x1="0" y1="0" x2="59" y2="81" stroke="#E8E4DE" stroke-width="1"/>
              <line x1="0" y1="0" x2="-59" y2="81" stroke="#E8E4DE" stroke-width="1"/>
              <line x1="0" y1="0" x2="-95" y2="-31" stroke="#E8E4DE" stroke-width="1"/>
              <polygon points="0,-65 74,-24 32,45 -35,57 -78,-26" fill="rgba(45,106,79,0.12)" stroke="#2D6A4F" stroke-width="2.5" stroke-linejoin="round"/>
              <circle cx="0" cy="-65" r="4" fill="#2D6A4F"/>
              <circle cx="74" cy="-24" r="4" fill="#2D6A4F"/>
              <circle cx="32" cy="45" r="4" fill="#2D6A4F"/>
              <circle cx="-35" cy="57" r="4" fill="#2D6A4F"/>
              <circle cx="-78" cy="-26" r="4" fill="#2D6A4F"/>
            </g>
            <text x="150" y="24" text-anchor="middle" font-family="Instrument Sans, sans-serif" font-size="12" fill="#555" font-weight="600">Cobertura</text>
            <text x="270" y="115" text-anchor="start" font-family="Instrument Sans, sans-serif" font-size="12" fill="#555" font-weight="600">Precisión</text>
            <text x="225" y="240" text-anchor="middle" font-family="Instrument Sans, sans-serif" font-size="12" fill="#555" font-weight="600">Simulacros</text>
            <text x="75" y="240" text-anchor="middle" font-family="Instrument Sans, sans-serif" font-size="12" fill="#555" font-weight="600">Velocidad</text>
            <text x="30" y="115" text-anchor="end" font-family="Instrument Sans, sans-serif" font-size="12" fill="#555" font-weight="600">Regularidad</text>
          </svg>
          <div class="radar-score">
            <span class="radar-score-num">73</span>
            <span class="radar-score-denom">/100</span>
          </div>
          <div class="radar-score-badge">Avanzado</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== RESOURCE DOWNLOAD ========== -->
  <section class="resource-section" aria-labelledby="resource-title">
    <div class="resource-inner">
      <h3 id="resource-title">Las 50 preguntas más repetidas en oposiciones AGE</h3>
      <p>Descarga gratis las preguntas que más se repiten en convocatorias de Auxiliar Administrativo (2018–2024). Sin registro.</p>
      <a href="/recursos/50-preguntas-age.pdf" class="btn-resource" download>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1B4332" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Descargar PDF gratis
      </a>
    </div>
  </section>

  <!-- ========== BLOG PREVIEW ========== -->
  {posts.length > 0 && (
    <section class="blog-section" aria-labelledby="blog-title">
      <div class="section-inner">
        <div class="eyebrow" style="text-align:center">Blog</div>
        <h2 id="blog-title" class="section-h2">Guías para opositores</h2>
        <p class="section-p">Artículos prácticos para preparar tu oposición con ciencia</p>
        <div class="blog-grid">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
              slug={post.id}
              emoji={post.data.emoji}
              readingTime={post.data.readingTime}
            />
          ))}
        </div>
        <a href="/blog" class="blog-all-link">Ver todos los artículos &rarr;</a>
      </div>
    </section>
  )}

  <!-- ========== FAQ ========== -->
  <section class="faq-section" id="faq" aria-labelledby="faq-title">
    <div class="section-inner" style="text-align:center">
      <div class="eyebrow">Preguntas frecuentes</div>
      <h2 id="faq-title" class="section-h2">Lo que quieres saber</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <div class="faq-question">¿Ya está disponible?</div>
          <div class="faq-answer">Sí, la app está disponible ahora mismo. Crea tu cuenta gratuita y empieza a practicar hoy. Sin tarjeta, sin contraseña larga.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">¿Qué oposición cubre?</div>
          <div class="faq-answer">Los 14 temas del Bloque I (Organización Pública) están completos con 1.414 preguntas. El Bloque II (Actividad Administrativa y Ofimática) está en desarrollo.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">¿Cuánto cuesta?</div>
          <div class="faq-answer">El acceso fundador durante la beta es completamente gratuito. Los primeros usuarios mantendrán condiciones especiales cuando implementemos el modelo de pago.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">¿Sustituye a la academia?</div>
          <div class="faq-answer">Es un complemento perfecto. Te ayuda a consolidar lo aprendido, detectar puntos débiles y mantener la retención sin depender de horarios fijos.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">¿Qué es el índice de preparación?</div>
          <div class="faq-answer">Un número del 0 al 100 que combina cobertura de temas (30%), precisión en respuestas (40%) y rendimiento en simulacros (30%). Cuando supera 75, estás listo.</div>
        </div>
        <div class="faq-item">
          <div class="faq-question">¿Funciona en móvil?</div>
          <div class="faq-answer">Sí, la app está optimizada para móvil. Diseñada para sesiones cortas de 5–15 minutos donde sea que estés.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== FINAL CTA ========== -->
  <section class="final-cta" aria-labelledby="final-cta-title">
    <h2 id="final-cta-title">La oposición no la gana<br>quien más estudia en junio.<br><em>La gana quien no olvida<br>lo de enero.</em></h2>
    <p>Crea tu cuenta gratuita en 30 segundos y descubre en qué punto estás. Sin tarjeta, sin letra pequeña.</p>
    <a href="https://app.opositasmart.com/#/welcome" class="btn-primary final-btn">Descubrir mi nivel de preparación</a>
    <div class="fine-print">Acceso fundador gratuito · Siempre podrás exportar tus datos · Sin trucos</div>
  </section>

  <!-- STICKY MOBILE CTA -->
  <div class="mobile-sticky-cta" aria-hidden="true">
    <a href="https://app.opositasmart.com/#/welcome" class="btn-primary">Ver mi nivel ahora — es gratis</a>
  </div>

</BaseLayout>

<style is:global>
  body {
    font-family: 'Instrument Sans', sans-serif;
    background: #F5F1EB;
    color: #1a1a1a;
    overflow-x: hidden;
  }
</style>

<style>
  /* ===== SHARED ===== */
  .eyebrow {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #2D6A4F;
  }

  .btn-primary {
    display: inline-block;
    background: linear-gradient(145deg, #1B4332, #2D6A4F);
    color: #fff;
    border: none;
    padding: 16px 36px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 600;
    font-family: 'Instrument Sans', sans-serif;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(27,67,50,0.25);
    transition: transform 0.2s, box-shadow 0.2s;
    text-decoration: none;
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(27,67,50,0.35);
    color: #fff;
  }

  .btn-secondary {
    display: inline-block;
    background: transparent;
    color: #2D6A4F;
    border: 1.5px solid #2D6A4F;
    padding: 15px 28px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 600;
    font-family: 'Instrument Sans', sans-serif;
    cursor: pointer;
    transition: background 0.2s;
    text-decoration: none;
  }
  .btn-secondary:hover {
    background: rgba(45,106,79,0.06);
  }

  /* ===== HERO ===== */
  .hero {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 48px;
  }
  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 80vh;
    gap: 60px;
    align-items: center;
  }
  .hero-eyebrow {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2.5px;
    color: #2D6A4F;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .hero-eyebrow::before {
    content: '';
    width: 24px;
    height: 1.5px;
    background: #2D6A4F;
  }
  .hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 62px;
    line-height: 1.05;
    letter-spacing: -2px;
  }
  .hero h1 em {
    color: #2D6A4F;
    font-style: italic;
  }
  .hero-sub {
    font-size: 17px;
    color: #5C5C5C;
