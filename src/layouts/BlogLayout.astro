---
import BaseLayout from './BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  readingTime?: string;
  emoji?: string;
}

const { title, description, date, category, readingTime, emoji } = Astro.props;

const categoryLabels: Record<string, string> = {
  temario: 'Temario',
  metodo: 'Método',
  convocatorias: 'Convocatorias',
  guias: 'Guías',
  consejos: 'Consejos',
};

const formattedDate = date.toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const pageTitle = `${title} | Blog Oposita Smart`;
---

<BaseLayout title={pageTitle} description={description}>
  <article class="blog-post">
    <div class="container">
      <div class="post-header">
        <a href="/blog" class="back-link">&larr; Volver al blog</a>
        <div class="post-meta">
          <span class="post-category">{categoryLabels[category] || category}</span>
          <span class="post-date">{formattedDate}</span>
          {readingTime && <span class="post-reading">{readingTime}</span>}
        </div>
        <h1 class="post-title">{emoji && <span class="post-emoji">{emoji}</span>}{title}</h1>
        <p class="post-description">{description}</p>
      </div>

      <div class="post-content">
        <slot />
      </div>

      <CTABanner />
    </div>
  </article>
</BaseLayout>

<style>
  .blog-post {
    padding: 100px 0 60px;
  }

  .post-header {
    max-width: 720px;
    margin: 0 auto 48px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 24px;
    transition: color 0.2s;
  }
  .back-link:hover {
    color: var(--green-primary);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 13px;
  }

  .post-category {
    background: var(--green-tint);
    color: var(--green-primary);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .post-date, .post-reading {
    color: var(--text-light);
  }

  .post-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text-heading);
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .post-emoji {
    margin-right: 8px;
  }

  .post-description {
    font-size: 18px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .post-content {
    max-width: 720px;
    margin: 0 auto 60px;
  }

  /* Prose styles */
  .post-content :global(h2) {
    font-size: 24px;
    font-weight: 700;
    color: var(--text-heading);
    margin-top: 48px;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
  }

  .post-content :global(h3) {
    font-size: 20px;
    font-weight: 600;
    color: var(--text-heading);
    margin-top: 36px;
    margin-bottom: 12px;
  }

  .post-content :global(p) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .post-content :global(li) {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 8px;
  }

  .post-content :global(strong) {
    color: var(--text-heading);
    font-weight: 600;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--green-primary);
    padding: 16px 24px;
    margin: 24px 0;
    background: var(--green-tint);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .post-content :global(blockquote p) {
    color: var(--text-body);
    margin-bottom: 0;
  }

  .post-content :global(code) {
    background: var(--border-light);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 15px;
  }

  .post-content :global(a) {
    color: var(--green-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .post-content :global(a:hover) {
    color: var(--green-deep);
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 24px 0;
    font-size: 15px;
  }

  .post-content :global(th) {
    background: var(--border-light);
    padding: 12px 16px;
    text-align: left;
    font-weight: 600;
    color: var(--text-heading);
  }

  .post-content :global(td) {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-light);
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .blog-post {
      padding: 80px 0 40px;
    }
    .post-meta {
      flex-wrap: wrap;
    }
  }
</style>
