---
/**
 * RadarOposiciones — Dashboard of current oposiciones status.
 * Redesigned for scannability: big numbers, clear status, minimal noise.
 */
---

<section class="radar-section" id="radar" aria-label="Radar de Oposiciones">
  <div class="container">
    <div class="radar-header">
      <span class="radar-badge">Actualización constante</span>
      <h2 class="radar-title">Radar de Oposiciones</h2>
      <p class="radar-subtitle">Estado actual de las principales convocatorias administrativas</p>
    </div>

    <!-- Filters -->
    <div class="radar-filters" role="group" aria-label="Filtros">
      <div class="filter-pills" id="ambito-filters">
        <button class="pill active" data-filter="todos">Todas</button>
        <button class="pill" data-filter="Estado">Estado</button>
        <button class="pill" data-filter="ccaa">CCAA</button>
      </div>
      <div class="filter-pills" id="nivel-filters">
        <button class="pill active" data-filter="todos">C1 + C2</button>
        <button class="pill" data-filter="C1">Solo C1</button>
        <button class="pill" data-filter="C2">Solo C2</button>
      </div>
    </div>

    <!-- Cards -->
    <div class="radar-list" id="radar-grid">
      <div class="radar-loading" id="radar-loading">
        <div class="loading-spinner"></div>
        <p>Cargando convocatorias...</p>
      </div>
    </div>

    <!-- Summary -->
    <div class="radar-summary" id="radar-summary"></div>

    <!-- CTA -->
    <div class="radar-cta">
      <p class="radar-cta-text">¿Preparando tu oposición?</p>
      <a href="https://app.opositasmart.com/#/welcome" class="radar-cta-button">
        Estudia con ciencia — Prueba gratis →
      </a>
    </div>
  </div>
</section>

<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script is:inline>
(function() {
  var SUPABASE_URL = 'https://yutfgmiyndmhsjhzxkdr.supabase.co';
  var SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inl1dGZnbWl5bmRtaHNqaHp4a2RyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjU4MDE2OTksImV4cCI6MjA4MTM3NzY5OX0.U1X8dmdHjzybKHtWJ4-kcJSrigELUhynhZcs8tU8NwI';

  var ESTADO_CONFIG = {
    pendiente_convocatoria: { label: 'Pendiente', color: '#6B7280', bg: '#F3F4F6', progress: 0 },
    convocada:              { label: 'Convocada', color: '#065F46', bg: '#D1FAE5', progress: 20 },
    plazo_inscripcion:      { label: 'Inscripción abierta', color: '#92400E', bg: '#FEF3C7', progress: 40 },
    lista_admitidos:        { label: 'Admitidos', color: '#1E40AF', bg: '#DBEAFE', progress: 60 },
    fecha_examen_confirmada:{ label: 'Fecha confirmada', color: '#065F46', bg: '#D1FAE5', progress: 80 },
    examen_realizado:       { label: 'Examen realizado', color: '#6B7280', bg: '#F3F4F6', progress: 90 },
    lista_aprobados:        { label: 'Resultados', color: '#065F46', bg: '#D1FAE5', progress: 100 },
  };

  function timeAgo(date) {
    var seconds = Math.floor((new Date() - new Date(date)) / 1000);
    if (seconds < 3600) return Math.floor(seconds / 60) + ' min';
    if (seconds < 86400) return Math.floor(seconds / 3600) + 'h';
    var days = Math.floor(seconds / 86400);
    return days === 1 ? '1 día' : days + ' días';
  }

  function formatDate(d) {
    if (!d) return null;
    var date = new Date(d);
    var months = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
    return date.getDate() + ' ' + months[date.getMonth()] + ' ' + date.getFullYear();
  }

  function daysUntil(d) {
    if (!d) return null;
    var diff = Math.ceil((new Date(d) - new Date()) / (1000 * 60 * 60 * 24));
    return diff > 0 ? diff : null;
  }

  function renderCard(item) {
    var estado = ESTADO_CONFIG[item.estado] || ESTADO_CONFIG.convocada;
    var days = daysUntil(item.fecha_examen);

    // Key metric: either countdown or plazas
    var metricHtml = '';
    if (days) {
      metricHtml =
        '<div class="card-metric">' +
          '<span class="metric-number">' + days + '</span>' +
          '<span class="metric-label">días para el examen' +
            (item.fecha_examen_estimada ? ' <span class="est-badge">est.</span>' : '') +
          '</span>' +
        '</div>';
    } else if (item.plazas) {
      metricHtml =
        '<div class="card-metric">' +
          '<span class="metric-number">' + item.plazas.toLocaleString('es-ES') + '</span>' +
          '<span class="metric-label">plazas convocadas</span>' +
        '</div>';
    }

    // Fecha line
    var fechaLine = '';
    if (item.fecha_examen) {
      fechaLine = '<div class="card-detail"><span class="detail-icon">📅</span> Examen: ' +
        formatDate(item.fecha_examen) +
        (item.fecha_examen_estimada ? ' <span class="est-badge">estimada</span>' : '') +
        '</div>';
    }

    // Plazas line (if countdown is shown as metric, still show plazas as detail)
    var plazasLine = '';
    if (days && item.plazas) {
      plazasLine = '<div class="card-detail"><span class="detail-icon">👥</span> ' +
        item.plazas.toLocaleString('es-ES') + ' plazas</div>';
    }

    // BOE link
    var boeLink = item.enlace_boe
      ? '<a href="' + item.enlace_boe + '" target="_blank" rel="noopener" class="card-boe">Ver en BOE →</a>'
      : '';

    return '<article class="radar-card" data-ambito="' + item.ambito + '" data-nivel="' + (item.nivel || '') + '">' +

      // Row 1: Status badge + level
      '<div class="card-row-top">' +
        '<span class="status-badge" style="color:' + estado.color + '; background:' + estado.bg + '">' +
          estado.label +
        '</span>' +
        '<span class="level-badge nivel-' + (item.nivel || '').toLowerCase() + '">' + (item.nivel || '—') + '</span>' +
      '</div>' +

      // Row 2: Title
      '<h3 class="card-title">' + item.nombre + '</h3>' +

      // Row 3: Ámbito
      '<span class="card-ambito">' + item.ambito + '</span>' +

      // Row 4: Key metric
      metricHtml +

      // Row 5: Progress bar
      '<div class="progress-track">' +
        '<div class="progress-fill" style="width: ' + estado.progress + '%; background:' + estado.color + '"></div>' +
      '</div>' +

      // Row 6: Details
      '<div class="card-details">' +
        fechaLine +
        plazasLine +
      '</div>' +

      // Row 7: Footer
      '<div class="card-footer">' +
        '<span class="card-updated">Actualizado ' + timeAgo(item.ultima_actualizacion) + '</span>' +
        boeLink +
      '</div>' +

    '</article>';
  }

  function renderSummary(data) {
    var totalPlazas = 0;
    var totalConvocadas = 0;
    data.forEach(function(item) {
      if (item.plazas) totalPlazas += item.plazas;
      totalConvocadas++;
    });
    var el = document.getElementById('radar-summary');
    if (el) {
      el.innerHTML =
        '<div class="summary-item"><span class="summary-num">' + totalConvocadas + '</span><span class="summary-label">convocatorias activas</span></div>' +
        '<div class="summary-divider"></div>' +
        '<div class="summary-item"><span class="summary-num">' + totalPlazas.toLocaleString('es-ES') + '</span><span class="summary-label">plazas totales</span></div>';
    }
  }

  async function loadRadar() {
    var client = window.supabase ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;
    if (!client) return;

    try {
      var result = await client.from('oposiciones_radar').select('*').order('plazas', { ascending: false, nullsFirst: false });
      if (result.error) throw result.error;
      var data = result.data;

      var grid = document.getElementById('radar-grid');
      var loading = document.getElementById('radar-loading');
      if (loading) loading.style.display = 'none';

      if (data && data.length > 0) {
        grid.innerHTML = data.map(renderCard).join('');
        renderSummary(data);
      } else {
        grid.innerHTML = '<p class="radar-empty">No hay convocatorias disponibles.</p>';
      }

      initFilters();
    } catch (err) {
      var loading = document.getElementById('radar-loading');
      if (loading) loading.innerHTML = '<p>Error al cargar datos.</p>';
    }
  }

  function initFilters() {
    document.querySelectorAll('.filter-pills').forEach(function(group) {
      group.addEventListener('click', function(e) {
        if (e.target.classList.contains('pill')) {
          group.querySelectorAll('.pill').forEach(function(p) { p.classList.remove('active'); });
          e.target.classList.add('active');
          applyFilters();
        }
      });
    });
  }

  function applyFilters() {
    var ambitoEl = document.querySelector('#ambito-filters .pill.active');
    var nivelEl = document.querySelector('#nivel-filters .pill.active');
    var ambito = ambitoEl ? ambitoEl.dataset.filter : 'todos';
    var nivel = nivelEl ? nivelEl.dataset.filter : 'todos';

    document.querySelectorAll('.radar-card').forEach(function(card) {
      var matchAmbito = ambito === 'todos' ||
        (ambito === 'ccaa' ? card.dataset.ambito !== 'Estado' : card.dataset.ambito === ambito);
      var matchNivel = nivel === 'todos' || card.dataset.nivel === nivel;
      card.style.display = (matchAmbito && matchNivel) ? '' : 'none';
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadRadar);
  } else {
    loadRadar();
  }
})();
</script>

<style>
  .radar-section {
    padding: 72px 0 48px;
  }

  /* Header */
  .radar-header {
    text-align: center;
    margin-bottom: 28px;
  }
  .radar-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent-primary);
    background: var(--accent-tint);
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    margin-bottom: 14px;
  }
  .radar-title {
    font-size: clamp(26px, 5vw, 38px);
    font-weight: 800;
    color: var(--text-heading);
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }
  .radar-subtitle {
    font-size: 16px;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto;
  }

  /* Filters */
  .radar-filters {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .filter-pills {
    display: flex;
    gap: 0;
    background: var(--border-light);
    border-radius: var(--radius-pill);
    padding: 3px;
  }
  .pill {
    font-size: 13px;
    font-weight: 500;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
    white-space: nowrap;
  }
  .pill:hover {
    color: var(--text-heading);
  }
  .pill.active {
    background: var(--bg-white);
    color: var(--text-heading);
    font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  /* Summary bar */
  .radar-summary {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 24px;
    margin-bottom: 24px;
    padding: 14px 0;
  }
  .summary-item {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .summary-num {
    font-size: 22px;
    font-weight: 800;
    color: var(--text-heading);
  }
  .summary-label {
    font-size: 14px;
    color: var(--text-muted);
  }
  .summary-divider {
    width: 1px;
    height: 24px;
    background: var(--border-medium);
  }

  /* Card list */
  .radar-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 768px) {
    .radar-list { grid-template-columns: repeat(2, 1fr); gap: 16px; }
  }

  /* Card */
  .radar-card {
    background: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 20px;
    transition: box-shadow 0.2s;
  }
  .radar-card:hover {
    box-shadow: var(--shadow-md);
  }

  /* Row: status + level */
  .card-row-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .status-badge {
    font-size: 12px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.01em;
  }
  .level-badge {
    font-size: 11px;
    font-weight: 800;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.04em;
  }
  .nivel-c1 {
    background: #EDE9FE;
    color: #5B21B6;
  }
  .nivel-c2 {
    background: #FEF3C7;
    color: #92400E;
  }

  /* Title */
  .card-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-heading);
    line-height: 1.3;
    margin-bottom: 4px;
  }

  /* Ámbito */
  .card-ambito {
    font-size: 13px;
    color: var(--text-muted);
    display: block;
    margin-bottom: 14px;
  }

  /* Key metric */
  .card-metric {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }
  .metric-number {
    font-size: 32px;
    font-weight: 800;
    color: var(--text-heading);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .metric-label {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .est-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    background: var(--warning-bg);
    color: #92400E;
    padding: 1px 6px;
    border-radius: var(--radius-pill);
    vertical-align: middle;
    margin-left: 2px;
  }

  /* Progress bar */
  .progress-track {
    height: 4px;
    background: var(--border-light);
    border-radius: 2px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.6s ease;
  }

  /* Details */
  .card-details {
    margin-bottom: 12px;
  }
  .card-detail {
    font-size: 13px;
    color: var(--text-secondary);
    padding: 4px 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .detail-icon {
    font-size: 14px;
    flex-shrink: 0;
  }

  /* Footer */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    border-top: 1px solid var(--border-light);
  }
  .card-updated {
    font-size: 11px;
    color: var(--text-light);
  }
  .card-boe {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-primary);
    text-decoration: none;
  }
  .card-boe:hover {
    text-decoration: underline;
  }

  /* Loading */
  .radar-loading {
    text-align: center;
    padding: 48px;
    color: var(--text-muted);
    grid-column: 1 / -1;
  }
  .loading-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--border-light);
    border-top-color: var(--accent-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 12px;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .radar-empty {
    text-align: center;
    color: var(--text-muted);
    padding: 48px;
    grid-column: 1 / -1;
  }

  /* CTA */
  .radar-cta {
    text-align: center;
    margin-top: 32px;
    padding: 28px 24px;
    background: var(--accent-tint);
    border-radius: var(--radius-xl);
  }
  .radar-cta-text {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 12px;
  }
  .radar-cta-button {
    display: inline-block;
    background: var(--gradient-cta);
    color: white;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 28px;
    border-radius: var(--radius-md);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .radar-cta-button:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-accent);
    color: white;
  }

  @media (max-width: 480px) {
    .radar-filters {
      flex-direction: column;
      align-items: center;
    }
    .metric-number {
      font-size: 28px;
    }
    .summary-num {
      font-size: 20px;
    }
  }
</style>
